jpg\nIMAGE_ROOT: None\n","output_type":"stream"}],"execution_count":5},{"id":"32e5e6a2-6f98-4aff-8779-93397ef503e3","cell_type":"code","source":"# ============================================================\n# 6. PATH RESOLUTION\n# ============================================================\ndef resolve_image_path(row):\n    # 1. absolute_path from QC manifest\n    if \"absolute_path\" in row.index:\n        p = Path(str(row[\"absolute_path\"]))\n        if p.exists():\n            return str(p)\n\n    # 2. relative_path under discovered input roots\n    rel = str(row[relative_col])\n\n    if IMAGE_ROOT is not None:\n        p = IMAGE_ROOT / rel\n        if p.exists():\n            return str(p)\n\n    # 3. Search all Kaggle input directories for the exact relative path\n    for root in KAGGLE_INPUT.iterdir():\n        if root.is_dir():\n            p = root / rel\n            if p.exists():\n                return str(p)\n\n    # 4. filename fallback\n    fname = Path(rel).name\n    hits = list(KAGGLE_INPUT.rglob(fname))\n    if hits:\n        return str(hits[0])\n\n    return None\n\nfor df in [train_df, val_df, test_df]:\n    df[\"image_path\"] = df.apply(resolve_image_path, axis=1)\n\nfor name, df in [(\"train\", train_df), (\"val\", val_df), (\"test\", test_df)]:\n    missing = df[\"image_path\"].isna().sum()\n    print(f\"{name}: missing image paths = {missing}\")\n    if missing:\n        print(df.loc[df[\"image_path\"].isna(), [relative_col]].head())\n        raise FileNotFoundError(f\"{name} contains unresolved image paths.\")\n\nprint(\"Path resolution: PASS\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T20:13:06.544236Z","iopub.execute_input":"2026-09-25T20:13:06.544481Z","iopub.status.idle":"2026-09-25T20:13:14.700673Z","shell.execute_reply.started":"2026-09-25T20:13:06.544461Z","shell.execute_reply":"2026-09-25T20:13:14.699748Z"}},"outputs":[{"name":"stdout","text":"train: missing image paths = 0\nval: missing image paths = 0\ntest: missing image paths = 0\nPath resolution: PASS\n","output_type":"stream"}],"execution_count":6},{"id":"dce41b0c-1570-4cc1-99f3-827df4f51ce4","cell_type":"markdown","source":"## 7. Define the hierarchy from the Experiment-1 labels\n\nThe notebook uses the existing hierarchy columns whenever they are available:\n\n- `l1_name`\n- `l2_name`\n- `l3a_name`\n- `l3b_name`\n- `l3c_name`\n\nThe terminal leaf label is constructed as:\n\n- Normal → `Normal`\n- Tumor → tumor subtype\n- Alzheimer → Alzheimer stage\n- Stroke → stroke type\n- Parkinson → `Parkinson`\n\nThis avoids inventing a new class mapping.","metadata":{}},{"id":"baa7693c-d4c7-4dbc-9650-737e1db9e7ef","cell_type":"code","source":"# ============================================================\n# 7. NORMALIZE HIERARCHY LABELS\n# ============================================================\nrequired_hierarchy = [\"l1_name\", \"l2_name\"]\nmissing_h = [c for c in required_hierarchy if c not in train_df.columns]\n\nif missing_h:\n    raise ValueError(f\"Required hierarchy columns missing from CSV: {missing_h}\")\n\ndef clean_label(x):\n    if pd.isna(x):\n        return None\n    s = str(x).strip()\n    return s if s and s.lower() not in {\"nan\", \"none\", \"null\"} else None\n\nfor df in [train_df, val_df, test_df]:\n    for c in [\"l1_name\", \"l2_name\", \"l3a_name\", \"l3b_name\", \"l3c_name\"]:\n        if c in df.columns:\n            df[c] = df[c].map(clean_label)\n\ndef make_leaf(row):\n    l1 = row[\"l1_name\"]\n    l2 = row[\"l2_name\"]\n\n    if l1 == \"Normal\":\n        return \"Normal\"\n\n    if l2 == \"Tumor\":\n        return row.get(\"l3a_name\") or \"Tumor\"\n\n    if l2 == \"Alzheimer\":\n        return row.get(\"l3b_name\") or \"Alzheimer\"\n\n    if l2 == \"Stroke\":\n        return row.get(\"l3c_name\") or \"Stroke\"\n\n    if l2 == \"Parkinson\":\n        return \"Parkinson\"\n\n    return l2\n\nfor df in [train_df, val_df, test_df]:\n    df[\"leaf_label\"] = df.apply(make_leaf, axis=1)\n\nprint(\"L1 classes:\", sorted(train_df[\"l1_name\"].dropna().unique()))\nprint(\"L2 classes:\", sorted(train_df[\"l2_name\"].dropna().unique()))\nprint(\"Leaf classes:\", sorted(train_df[\"leaf_label\"].dropna().unique()))\n\nprint(\"\\nTrain leaf distribution:\")\nprint(train_df[\"leaf_label\"].value_counts())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T20:13:14.70177Z","iopub.execute_input":"2026-09-25T20:13:14.702074Z","iopub.status.idle":"2026-09-25T20:13:14.861452Z","shell.execute_reply.started":"2026-09-25T20:13:14.702053Z","shell.execute_reply":"2026-09-25T20:13:14.8605Z"}},"outputs":[{"name":"stdout","text":"L1 classes: ['Disease', 'Normal']\nL2 classes: ['Alzheimer', 'Parkinson', 'Stroke', 'Tumor']\nLeaf classes: ['Glioma', 'Hemorrhagic', 'Ischemic', 'Meningioma', 'MildDemented', 'ModerateDemented', 'NonDemented', 'Normal', 'Parkinson', 'Pituitary', 'VeryMildDemented']\n\nTrain leaf distribution:\nleaf_label\nNonDemented         2247\nVeryMildDemented    1567\nPituitary           1279\nMeningioma          1269\nGlioma              1235\nNormal              1231\nMildDemented         630\nModerateDemented     202\nParkinson            153\nIschemic             127\nHemorrhagic          123\nName: count, dtype: int64\n","output_type":"stream"}],"execution_count":7},{"id":"0d18437e-ec16-4e30-80e0-4725ce40758a","cell_type":"code","source":"# ============================================================\n# 8. DATASET + TRANSFORMS\n# ============================================================\nMEAN = [0.485, 0.456, 0.406]\nSTD  = [0.229, 0.224, 0.225]\n\ntrain_tf = transforms.Compose([\n    transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),\n    transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomRotation(10),\n    transforms.ToTensor(),\n    transforms.Normalize(MEAN, STD),\n])\n\neval_tf = transforms.Compose([\n    transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize(MEAN, STD),\n])\n\nclass CNSDataset(Dataset):\n    def __init__(self, df, label_col, class_to_idx, transform):\n        self.df = df.reset_index(drop=True).copy()\n        self.label_col = label_col\n        self.class_to_idx = class_to_idx\n        self.transform = transform\n\n        self.labels = [\n            self.class_to_idx[str(x)]\n            for x in self.df[self.label_col].astype(str)\n        ]\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n        path = row[\"image_path\"]\n\n        with Image.open(path) as img:\n            img = img.convert(\"RGB\")\n\n        if self.transform:\n            img = self.transform(img)\n\n        return img, self.labels[idx], idx\n\ndef make_loaders(train_df, val_df, test_df, label_col):\n    classes = sorted(train_df[label_col].astype(str).unique())\n    class_to_idx = {c:i for i,c in enumerate(classes)}\n    idx_to_class = {i:c for c,i in class_to_idx.items()}\n\n    tr_ds = CNSDataset(train_df, label_col, class_to_idx, train_tf)\n    va_ds = CNSDataset(val_df, label_col, class_to_idx, eval_tf)\n    te_ds = CNSDataset(test_df, label_col, class_to_idx, eval_tf)\n\n    tr_loader = DataLoader(\n        tr_ds, batch_size=BATCH_SIZE, shuffle=True,\n        num_workers=NUM_WORKERS, pin_memory=torch.cuda.is_available(),\n        persistent_workers=(NUM_WORKERS > 0)\n    )\n    va_loader = DataLoader(\n        va_ds, batch_size=BATCH_SIZE, shuffle=False,\n        num_workers=NUM_WORKERS, pin_memory=torch.cuda.is_available(),\n        persistent_workers=(NUM_WORKERS > 0)\n    )\n    te_loader = DataLoader(\n        te_ds, batch_size=BATCH_SIZE, shuffle=False,\n        num_workers=NUM_WORKERS, pin_memory=torch.cuda.is_available(),\n        persistent_workers=(NUM_WORKERS > 0)\n    )\n    return tr_loader, va_loader, te_loader, classes, class_to_idx, idx_to_class\n\ndef class_weights(df, label_col, classes):\n    counts = df[label_col].astype(str).value_counts()\n    weights = np.array([\n        len(df) / (len(classes) * max(counts.get(c, 1), 1))\n        for c in classes\n    ], dtype=np.float32)\n    return torch.tensor(weights, dtype=torch.float32, device=DEVICE)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T20:13:14.862561Z","iopub.execute_input":"2026-09-25T20:13:14.862882Z","iopub.status.idle":"2026-09-25T20:13:14.876167Z","shell.execute_reply.started":"2026-09-25T20:13:14.862859Z","shell.execute_reply":"2026-09-25T20:13:14.87503Z"}},"outputs":[],"execution_count":8},{"id":"e35a15c9-d782-44c8-926c-657fdb32b06a","cell_type":"code","source":"# ============================================================\n# 9. DENSENET121 MODEL — SAME BACKBONE FOR BOTH SYSTEMS\n# ============================================================\ndef build_densenet(num_classes):\n    weights = models.DenseNet121_Weights.IMAGENET1K_V1\n    model = models.densenet121(weights=weights)\n    in_features = model.classifier.in_features\n    model.classifier = nn.Linear(in_features, num_classes)\n    return model.to(DEVICE)\n\ndef make_criterion(train_df, label_col, classes):\n    w = class_weights(train_df, label_col, classes)\n    return nn.CrossEntropyLoss(weight=w)\n\nprint(\"DenseNet121: ImageNet-pretrained + full fine-tuning\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T20:13:14.877243Z","iopub.execute_input":"2026-09-25T20:13:14.877555Z","iopub.status.idle":"2026-09-25T20:13:14.88956Z","shell.execute_reply.started":"2026-09-25T20:13:14.877506Z","shell.execute_reply":"2026-09-25T20:13:14.888868Z"}},"outputs":[{"name":"stdout","text":"DenseNet121: ImageNet-pretrained + full fine-tuning\n","output_type":"stream"}],"execution_count":9},{"id":"9f9d1c59-c8e6-4d7c-94e2-e0991cc2500d","cell_type":"code","source":"# ============================================================\n# 10. TRAINING / EVALUATION UTILITIES\n# ============================================================\ndef run_epoch(model, loader, criterion, optimizer=None):\n    is_train = optimizer is not None\n    model.train(is_train)\n\n    total_loss = 0.0\n    y_true, y_pred, y_prob = [], [], []\n\n    for x, y, _ in loader:\n        x = x.to(DEVICE, non_blocking=True)\n        y = y.to(DEVICE, non_blocking=True)\n\n        if is_train:\n            optimizer.zero_grad(set_to_none=True)\n\n        with torch.set_grad_enabled(is_train):\n            logits = model(x)\n            loss = criterion(logits, y)\n\n            if is_train:\n                loss.backward()\n                optimizer.step()\n\n        total_loss += loss.item() * x.size(0)\n\n        probs = torch.softmax(logits, dim=1)\n        preds = probs.argmax(dim=1)\n\n        y_true.extend(y.detach().cpu().numpy())\n        y_pred.extend(preds.detach().cpu().numpy())\n        y_prob.append(probs.detach().cpu().numpy())\n\n    return (\n        total_loss / len(loader.dataset),\n        np.array(y_true),\n        np.array(y_pred),\n        np.concatenate(y_prob, axis=0)\n    )\n\ndef safe_auc(y_true, y_prob, n_classes):\n    try:\n        if n_classes == 2:\n            return roc_auc_score(y_true, y_prob[:,1])\n        y_bin = label_binarize(y_true, classes=np.arange(n_classes))\n        return roc_auc_score(y_bin, y_prob, multi_class=\"ovr\", average=\"macro\")\n    except Exception:\n        return np.nan\n\ndef metrics_from_predictions(y_true, y_pred, y_prob, classes):\n    n_classes = len(classes)\n\n    out = {\n        \"Accuracy\": accuracy_score(y_true, y_pred),\n        \"Balanced_Accuracy\": balanced_accuracy_score(y_true, y_pred),\n        \"Macro_F1\": f1_score(y_true, y_pred, average=\"macro\", zero_division=0),\n        \"Weighted_F1\": f1_score(y_true, y_pred, average=\"weighted\", zero_division=0),\n        \"MCC\": matthews_corrcoef(y_true, y_pred),\n        \"Cohen_Kappa\": cohen_kappa_score(y_true, y_pred),\n        \"ROC_AUC\": safe_auc(y_true, y_prob, n_classes),\n    }\n    return out\n\ndef train_model(model, train_loader, val_loader, criterion, name):\n    optimizer = torch.optim.AdamW(\n        model.parameters(),\n        lr=LEARNING_RATE,\n        weight_decay=WEIGHT_DECAY\n    )\n\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode=\"min\", factor=0.5, patience=2\n    )\n\n    best_val_loss = float(\"inf\")\n    best_epoch = 0\n    bad_epochs = 0\n    history = []\n    start = time.perf_counter()\n\n    ckpt_path = OUTPUT_ROOT / \"checkpoints\" / f\"{name}_best.pt\"\n\n    for epoch in range(1, EPOCHS + 1):\n        t0 = time.perf_counter()\n\n        tr_loss, tr_y, tr_p, tr_prob = run_epoch(\n            model, train_loader, criterion, optimizer\n        )\n        va_loss, va_y, va_p, va_prob = run_epoch(\n            model, val_loader, criterion, None\n        )\n\n        tr_acc = accuracy_score(tr_y, tr_p)\n        va_acc = accuracy_score(va_y, va_p)\n\n        scheduler.step(va_loss)\n\n        history.append({\n            \"epoch\": epoch,\n            \"train_loss\": tr_loss,\n            \"val_loss\": va_loss,\n            \"train_accuracy\": tr_acc,\n            \"val_accuracy\": va_acc,\n            \"lr\": optimizer.param_groups[0][\"lr\"],\n            \"epoch_time_sec\": time.perf_counter() - t0\n        })\n\n        print(\n            f\"{name} | Epoch {epoch:02d} | \"\n            f\"Train Loss {tr_loss:.4f} | Val Loss {va_loss:.4f} | \"\n            f\"Train Acc {tr_acc:.4f} | Val Acc {va_acc:.4f}\"\n        )\n\n        if va_loss < best_val_loss - 1e-5:\n            best_val_loss = va_loss\n            best_epoch = epoch\n            bad_epochs = 0\n            torch.save({\n                \"model_state_dict\": model.state_dict(),\n                \"epoch\": epoch,\n                \"val_loss\": va_loss,\n            }, ckpt_path)\n        else:\n            bad_epochs += 1\n            if bad_epochs >= PATIENCE:\n                print(\"Early stopping.\")\n                break\n\n    total_time = time.perf_counter() - start\n\n    checkpoint = torch.load(ckpt_path, map_location=DEVICE)\n    model.load_state_dict(checkpoint[\"model_state_dict\"])\n\n    history_df = pd.DataFrame(history)\n    history_df.to_csv(\n        OUTPUT_ROOT / \"metrics\" / f\"{name}_history.csv\", index=False\n    )\n\n    return model, history_df, best_epoch, total_time\n\ndef evaluate_model(model, loader, classes, split_name, system_name):\n    model.eval()\n    y_true, y_pred, y_prob, row_indices = [], [], [], []\n\n    start = time.perf_counter()\n\n    with torch.no_grad():\n        for x, y, idx in loader:\n            x = x.to(DEVICE, non_blocking=True)\n            logits = model(x)\n            probs = torch.softmax(logits, dim=1)\n            preds = probs.argmax(dim=1)\n\n            y_true.extend(y.numpy())\n            y_pred.extend(preds.cpu().numpy())\n            y_prob.append(probs.cpu().numpy())\n            row_indices.extend(idx.numpy())\n\n    inference_time = time.perf_counter() - start\n    y_true = np.array(y_true)\n    y_pred = np.array(y_pred)\n    y_prob = np.concatenate(y_prob, axis=0)\n\n    metrics = metrics_from_predictions(\n        y_true, y_pred, y_prob, classes\n    )\n    metrics[\"Inference_Time_sec\"] = inference_time\n    metrics[\"N\"] = len(y_true)\n\n    pred_df = pd.DataFrame({\n        \"row_index\": row_indices,\n        \"true_idx\": y_true,\n        \"pred_idx\": y_pred,\n        \"true_label\": [classes[i] for i in y_true],\n        \"pred_label\": [classes[i] for i in y_pred],\n    })\n\n    for i, c in enumerate(classes):\n        pred_df[f\"prob_{c}\"] = y_prob[:, i]\n\n    pred_df[\"system\"] = system_name\n    pred_df[\"split\"] = split_name\n\n    return metrics, pred_df, y_true, y_pred, y_prob","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T20:13:14.891726Z","iopub.execute_input":"2026-09-25T20:13:14.89195Z","iopub.status.idle":"2026-09-25T20:13:14.912915Z","shell.execute_reply.started":"2026-09-25T20:13