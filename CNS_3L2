====================================================\n# Build test loader preserving original test_df row order.\nfull_test_loader = DataLoader(\n    CNSDataset(\n        test_df, \"leaf_label\",\n        {c:i for i,c in enumerate(sorted(test_df[\"leaf_label\"].unique()))},\n        eval_tf\n    ),\n    batch_size=BATCH_SIZE, shuffle=False,\n    num_workers=NUM_WORKERS,\n    pin_memory=torch.cuda.is_available(),\n    persistent_workers=(NUM_WORKERS > 0)\n)\n\n# We need model predictions aligned to the original test_df.\n# Re-run each hierarchy model over selected subsets and write predictions by dataframe index.\n\nhier_pred = np.array([\"\"] * len(test_df), dtype=object)\n\n# L1 predictions on all test images\n_, l1_all_pred_df, _, _, _ = evaluate_model(\n    l1_model, l1_te, l1_classes, \"test\", \"Hierarchical_L1\"\n)\n\n# l1_te corresponds to the subset/order used by make_loaders on test_df.\n# For L1 it is all test_df, so row_index maps directly.\nl1_pred_by_row = dict(zip(\n    l1_all_pred_df[\"row_index\"].astype(int),\n    l1_all_pred_df[\"pred_label\"].astype(str)\n))\n\n# L2 predictions are on disease-only test subset.\n_, l2_all_pred_df, _, _, _ = evaluate_model(\n    l2_model, l2_te, l2_classes, \"test\", \"Hierarchical_L2\"\n)\n\n# L3 predictions are disease-specific subsets.\nl3_pred_maps = {}\nfor disease, obj in l3_predictions.items():\n    pred_df = obj[\"pred_df\"]\n    te_sub = obj[\"test_df\"]\n\n    # Dataset row_index is local to the disease subset.\n    # Map using the original test dataframe index stored before reset.\n    original_indices = test_df[\n        test_df[\"l2_name\"] == disease\n    ].index.tolist()\n\n    valid_mask = test_df.loc[original_indices, obj[\"label_col\"]].notna().values\n    original_indices = np.array(original_indices)[valid_mask]\n\n    l3_pred_maps[disease] = {\n        int(orig_idx): pred_label\n        for orig_idx, pred_label in zip(\n            original_indices,\n            pred_df[\"pred_label\"].astype(str).tolist()\n        )\n    }\n\n# L2 local row indices map to disease-only test dataframe order.\nl2_test_original_indices = test_df[\n    test_df[\"l1_name\"] == \"Disease\"\n].index.tolist()\n\nl2_map = {\n    int(orig_idx): pred_label\n    for orig_idx, pred_label in zip(\n        l2_test_original_indices,\n        l2_all_pred_df[\"pred_label\"].astype(str).tolist()\n    )\n}\n\nfor orig_idx in range(len(test_df)):\n    l1_pred = l1_pred_by_row[orig_idx]\n\n    if l1_pred == \"Normal\":\n        hier_pred[orig_idx] = \"Normal\"\n        continue\n\n    disease_pred = l2_map.get(orig_idx, None)\n\n    if disease_pred is None:\n        hier_pred[orig_idx] = \"UNKNOWN\"\n        continue\n\n    if disease_pred == \"Parkinson\":\n        hier_pred[orig_idx] = \"Parkinson\"\n    elif disease_pred in l3_pred_maps:\n        hier_pred[orig_idx] = l3_pred_maps[disease_pred].get(\n            orig_idx, \"UNKNOWN\"\n        )\n    else:\n        hier_pred[orig_idx] = disease_pred\n\ntrue_leaf = test_df[\"leaf_label\"].astype(str).values\n\nprint(\"Unknown predictions:\", np.sum(hier_pred == \"UNKNOWN\"))\nprint(\"Hierarchical end-to-end accuracy:\",\n      accuracy_score(true_leaf, hier_pred))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T21:55:16.558496Z","iopub.execute_input":"2026-09-25T21:55:16.559053Z","iopub.status.idle":"2026-09-25T21:55:29.968068Z","shell.execute_reply.started":"2026-09-25T21:55:16.558999Z","shell.execute_reply":"2026-09-25T21:55:29.96739Z"}},"outputs":[{"name":"stdout","text":"Unknown predictions: 7\nHierarchical end-to-end accuracy: 0.9782407407407407\n","output_type":"stream"}],"execution_count":16},{"id":"1240db0e-6730-44b4-b2d7-ee4160b96d5c","cell_type":"code","source":"# ============================================================\n# 15. END-TO-END HIERARCHICAL METRICS\n# ============================================================\nleaf_classes = sorted(train_df[\"leaf_label\"].astype(str).unique())\nleaf_to_idx = {c:i for i,c in enumerate(leaf_classes)}\n\ntrue_idx = np.array([leaf_to_idx[x] for x in true_leaf])\npred_idx = np.array([\n    leaf_to_idx.get(x, -1) for x in hier_pred\n])\n\nvalid = pred_idx >= 0\n\nhier_e2e_metrics = {\n    \"Accuracy\": accuracy_score(true_idx[valid], pred_idx[valid]),\n    \"Balanced_Accuracy\": balanced_accuracy_score(\n        true_idx[valid], pred_idx[valid]\n    ),\n    \"Macro_F1\": f1_score(\n        true_idx[valid], pred_idx[valid],\n        average=\"macro\", zero_division=0\n    ),\n    \"Weighted_F1\": f1_score(\n        true_idx[valid], pred_idx[valid],\n        average=\"weighted\", zero_division=0\n    ),\n    \"MCC\": matthews_corrcoef(true_idx[valid], pred_idx[valid]),\n    \"Cohen_Kappa\": cohen_kappa_score(\n        true_idx[valid], pred_idx[valid]\n    ),\n    \"N\": int(len(true_idx)),\n    \"Unknown_Predictions\": int(np.sum(~valid)),\n}\n\nprint(pd.Series(hier_e2e_metrics))\n\nhier_e2e_df = test_df.copy()\nhier_e2e_df[\"hierarchical_prediction\"] = hier_pred\nhier_e2e_df[\"correct_end_to_end\"] = (\n    hier_e2e_df[\"leaf_label\"].astype(str) == hier_e2e_df[\"hierarchical_prediction\"]\n)\n\nhier_e2e_df.to_csv(\n    OUTPUT_ROOT / \"predictions\" / \"hierarchical_end_to_end_predictions.csv\",\n    index=False\n)\n\nwith open(OUTPUT_ROOT / \"metrics\" / \"hierarchical_end_to_end_metrics.json\", \"w\") as f:\n    json.dump(hier_e2e_metrics, f, indent=2)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T21:55:29.969218Z","iopub.execute_input":"2026-09-25T21:55:29.969532Z","iopub.status.idle":"2026-09-25T21:55:30.029894Z","shell.execute_reply.started":"2026-09-25T21:55:29.9695Z","shell.execute_reply":"2026-09-25T21:55:30.029198Z"}},"outputs":[{"name":"stdout","text":"Accuracy                  0.981421\nBalanced_Accuracy         0.981940\nMacro_F1                  0.982735\nWeighted_F1               0.981392\nMCC                       0.978454\nCohen_Kappa               0.978433\nN                      216